---
- name: variable precendence
  hosts: app_servers
  become: yes
  gather_facts: yes

  tasks:
    - name: create a variable file
      ansible.builtin.copy:
        content: |
          APP_ENV: "{{ app_environment }}" 
          APP_PORT: "{{ app_port }}"
        dest: /etc/myapp.conf
      tags:
        - variable

